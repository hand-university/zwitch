{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ZWitch",
  "version": "0.1.0",
  "identifier": "com.zhangqiang.zwitch",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "ZWitch",
        "width": 920,
        "height": 780,
        "minWidth": 720,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["zwitch"]
      },
      "mobile": [
        {
          "scheme": ["zwitch"]
        }
      ]
    },
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDRCNUQ5RDM3RDY1NDgzOEMKUldTTWcxVFdONTFkUzRKZ0hhMXNEcXMrby9iakFMcGNjR1F1TTZRd1MyZWtkb1NqVmVMNTMvdXMK",
      "endpoints": [
        "https://ft-wxhand.com/zai/api/aone/zwitch/updates/{{target}}/{{arch}}/{{current_version}}"
      ]
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "macOS": {
      "infoPlist": "Info.plist"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
